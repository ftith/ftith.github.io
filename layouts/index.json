{{- $index := slice -}}
{{- range site.RegularPages -}}
  {{- if and (not .Params.searchHidden) (ne .Layout "archives") (ne .Layout "search") -}}
    {{- $index = $index | append (dict
      "title" .Title
      "permalink" .Permalink
      "summary" (.Summary | plainify)
      "content" .Plain
      "tags" (delimit (.Params.tags | default (slice)) " ")
    ) -}}
  {{- end -}}
{{- end -}}
{{- $index | jsonify -}}
